[Unit]
Description=<BRAND_NAME> daily sprint-standup
After=network.target

[Service]
Type=oneshot
Environment="REPO_ROOT=<REPO_ROOT>"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
WorkingDirectory=<REPO_ROOT>
ExecStart=/bin/bash -c 'SLUG=$(bash scripts/sprint-status.sh --slug-only 2>/dev/null) && [ -n "$SLUG" ] && /usr/bin/env node scripts/sprint-standup.mjs "$SLUG" || true'
StandardOutput=append:<REPO_ROOT>/.swarm/sprint-standup.log
StandardError=append:<REPO_ROOT>/.swarm/sprint-standup.err
