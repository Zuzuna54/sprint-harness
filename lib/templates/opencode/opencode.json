{
  "$schema": "https://opencode.ai/config.json",
  "_doc": "Generated by @ordex/sprint-harness install for OpenCode runtime. Claude Code compatible - hooks and skills auto-discovered.",
  "plugin": [
    "opencode-claude-hooks"
  ],
  "mcp": {
    "opencode-orchestrator": {
      "type": "local",
      "command": ["npx", "-y", "opencode-orchestrator@latest", "mcp", "start"],
      "enabled": true,
      "environment": {}
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@context7/mcp-server"],
      "enabled": true
    }
  },
  "claudeFlow": {
    "version": "3.7.0",
    "enabled": false,
    "_note": "OpenCode uses opencode-orchestrator instead of claude-flow"
  }
}