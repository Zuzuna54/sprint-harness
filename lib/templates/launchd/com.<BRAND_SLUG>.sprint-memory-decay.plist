<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.<BRAND_SLUG>.sprint-memory-decay</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>/Users/gio/Desktop/<BRAND_SLUG>/scripts/sprint-memory-decay.mjs</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>REPO_ROOT</key>
    <string>/Users/gio/Desktop/<BRAND_SLUG></string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/gio/Desktop/<BRAND_SLUG>/.swarm/memory-decay.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/gio/Desktop/<BRAND_SLUG>/.swarm/memory-decay.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
