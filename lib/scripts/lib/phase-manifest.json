{
  "$schema": "./phase-manifest.schema.json",
  "version": "1.1.0",
  "_comment": "deferred_gates[] (T4 from harness-deterministic-phases-v1): gate names listed in some phase's required_sub_step_gates[] but NOT yet instrumented by record_sub_step. Predicate engine treats missing-and-no-bypass for these as [DEFERRED] (counts separately, doesn't block phase advance). Follow-up sprint harness-verify-instrumentation-v1 wires the instrumentation; gates get removed from deferred_gates[] as they land. See docs/sprints/_guides/sub-step-coverage.md.",
  "deferred_gates": [],
  "phases": {
    "spec-wizard": {
      "advances_to": ["spec-locked", "paused"],
      "required_artifacts": [
        {
          "kind": "file_min_bytes",
          "path": "spec.md",
          "min_bytes": 500
        },
        {
          "kind": "file_min_bytes",
          "path": "wizard-transcript.md",
          "min_bytes": 100
        },
        {
          "kind": "json_path_in",
          "path": "spec.partial.json",
          "json_path": ".current_section",
          "in": ["complete", "J"]
        }
      ],
      "required_state_fields": [
        {
          "kind": "state_field_all_values_in",
          "json_path": ".wizard_state.sections_status[]",
          "in": ["complete", "skipped", "in-progress"]
        }
      ],
      "required_sub_step_gates": [
        "wizard-section-A",
        "wizard-section-B",
        "wizard-section-C",
        "wizard-section-D",
        "wizard-section-E",
        "wizard-section-F",
        "wizard-section-G",
        "wizard-section-H",
        "wizard-section-I",
        "wizard-section-J",
        "wizard-coherence-after-C",
        "wizard-coherence-after-F",
        "wizard-coherence-after-I",
        "wizard-assemble"
      ]
    },
    "spec-locked": {
      "advances_to": ["design-locked", "paused"],
      "required_artifacts": [
        {
          "kind": "file_min_bytes",
          "path": "solution-sketches.md",
          "min_bytes": 200
        },
        {
          "kind": "file_min_bytes",
          "path": "architect-review.md",
          "min_bytes": 200
        },
        {
          "kind": "file_min_bytes",
          "path": "security-review.md",
          "min_bytes": 200
        },
        {
          "kind": "json_path_in",
          "path": "consensus-spec.json",
          "json_path": ".verdict",
          "in": ["pass", "pass-with-notes"]
        },
        {
          "kind": "file_exists",
          "path": ".baseline-embedding.json"
        }
      ],
      "required_state_fields": [
        {
          "kind": "state_field_min_length",
          "json_path": ".files_touched",
          "min_length": 1
        },
        {
          "kind": "json_path_in",
          "path": "state.json",
          "json_path": ".worker_rigor",
          "in": ["lax", "strict"]
        }
      ],
      "required_sub_step_gates": [
        "spec-lock-solution-sketches",
        "spec-lock-architect-review",
        "spec-lock-security-review",
        "spec-lock-hive-mind-consensus",
        "spec-lock-baseline-written"
      ]
    },
    "design-locked": {
      "advances_to": ["building", "paused"],
      "required_artifacts": [
        {
          "kind": "file_min_bytes",
          "path": "design.md",
          "min_bytes": 300
        }
      ],
      "required_state_fields": [
        {
          "kind": "json_path_present",
          "path": "state.json",
          "json_path": ".design_locked_at"
        }
      ],
      "required_sub_step_gates": [
        "design-sparc-spec-pseudocode",
        "design-sparc-architect",
        "design-locked"
      ]
    },
    "building": {
      "advances_to": ["day-5-checkin", "cleaning", "verifying", "paused"],
      "required_artifacts": [],
      "required_state_fields": [
        {
          "kind": "state_field_min_length",
          "json_path": ".acs_total",
          "min_length": 1,
          "applies_to": "number"
        }
      ],
      "required_sub_step_gates": ["build-launched"],
      "comment": "Per-commit gates (drift, scope, duplication) are enforced by husky + PreToolUse hooks, not by phase advance"
    },
    "day-5-checkin": {
      "advances_to": ["building", "cleaning", "verifying", "paused"],
      "required_artifacts": [
        {
          "kind": "file_contains_heading",
          "path": "check-in-day5.md",
          "heading": "### Cut",
          "min_chars_under": 30
        },
        {
          "kind": "file_contains_heading",
          "path": "check-in-day5.md",
          "heading": "### Push",
          "min_chars_under": 30
        },
        {
          "kind": "file_contains_heading",
          "path": "check-in-day5.md",
          "heading": "### Pivot",
          "min_chars_under": 30
        }
      ],
      "required_state_fields": [],
      "required_sub_step_gates": [
        "day-5-question-cut",
        "day-5-question-push",
        "day-5-question-pivot",
        "day-5-hill-chart-refreshed"
      ]
    },
    "cleaning": {
      "advances_to": ["verifying", "paused"],
      "required_artifacts": [],
      "required_state_fields": [],
      "required_sub_step_gates": [
        "cleanup-deadcode-delete",
        "cleanup-lint-fix",
        "cleanup-claude-md-clean"
      ]
    },
    "verifying": {
      "advances_to": ["audit-resolution", "building", "paused", "pre-deploy", "review-resolution"],
      "required_artifacts": [],
      "required_state_fields": [
        {
          "kind": "state_field_min_length",
          "json_path": ".verify_runs",
          "min_length": 1
        }
      ],
      "required_sub_step_gates": [
        "verify-typecheck",
        "verify-lint",
        "verify-tests",
        "verify-api-contract",
        "verify-debug-rls",
        "verify-module-status",
        "verify-perf-profile",
        "verify-aidefence-scan",
        "verify-sonar",
        "verify-knip",
        "verify-cycle-check",
        "verify-audit-deps",
        "verify-bundle-budget",
        "verify-coverage-delta",
        "verify-migration-check",
        "verify-worker-audit",
        "verify-worker-testgaps",
        "verify-worker-optimize"
      ],
      "strict_only_sub_step_gates": [
        "verify-worker-map-refreshed",
        "verify-worker-consolidate-refreshed"
      ],
      "comment": "strict_only_sub_step_gates apply only when state.worker_rigor == 'strict'"
    },
    "pre-deploy": {
      "advances_to": ["deploying", "paused"],
      "required_artifacts": [
        {
          "kind": "file_min_bytes",
          "path": "pre-deploy-review.md",
          "min_bytes": 200
        }
      ],
      "required_state_fields": [
        {
          "kind": "json_path_present",
          "path": "state.json",
          "json_path": ".predeploy_at"
        }
      ],
      "required_sub_step_gates": ["pre-deploy-reviewer-agent", "pre-deploy-security-architect"]
    },
    "deploying": {
      "advances_to": ["done", "paused"],
      "required_artifacts": [],
      "required_state_fields": [],
      "required_sub_step_gates": [
        "deploy-pulumi-preview-captured",
        "deploy-human-gate-approved",
        "deploy-pulumi-up",
        "deploy-smoke",
        "deploy-vercel"
      ]
    },
    "done": {
      "advances_to": [],
      "required_artifacts": [
        {
          "kind": "file_contains_heading",
          "path": "retro.md",
          "heading": "## What worked",
          "min_chars_under": 50
        },
        {
          "kind": "file_contains_heading",
          "path": "retro.md",
          "heading": "## What didn't",
          "min_chars_under": 50
        },
        {
          "kind": "file_contains_heading",
          "path": "retro.md",
          "heading": "## What surprised us",
          "min_chars_under": 50
        },
        {
          "kind": "file_contains_heading",
          "path": "retro.md",
          "heading": "## Patterns extracted",
          "min_chars_under": 100
        },
        {
          "kind": "file_contains_heading",
          "path": "retro.md",
          "heading": "## CLAUDE.md updates proposed",
          "min_chars_under": 10
        },
        {
          "kind": "file_contains_heading",
          "path": "retro.md",
          "heading": "## Open follow-ups",
          "min_chars_under": 10
        },
        {
          "kind": "file_exists",
          "path": "metrics.json"
        },
        {
          "kind": "file_exists",
          "path": "dashboard.html"
        }
      ],
      "required_state_fields": [
        {
          "kind": "json_path_present",
          "path": "state.json",
          "json_path": ".closed_at"
        }
      ],
      "required_sub_step_gates": [
        "retro-worked",
        "retro-didnt",
        "retro-surprised",
        "retro-pattern-1",
        "retro-pattern-2",
        "retro-pattern-3",
        "retro-claude-md",
        "retro-followups",
        "daa-feedback-batched",
        "trajectory-closed",
        "velocity-computed"
      ]
    },
    "paused": {
      "advances_to": [
        "spec-wizard",
        "spec-locked",
        "design-locked",
        "building",
        "day-5-checkin",
        "cleaning",
        "verifying",
        "pre-deploy",
        "deploying"
      ],
      "required_artifacts": [],
      "required_state_fields": [
        {
          "kind": "json_path_present",
          "path": "state.json",
          "json_path": ".prev_phase"
        }
      ],
      "required_sub_step_gates": [],
      "comment": "Resume restores prev_phase; no new sub-step gates required"
    },
    "audit-resolution": {
      "advances_to": ["pre-deploy", "verifying", "paused"],
      "required_artifacts": [
        {
          "kind": "file_min_bytes",
          "path": "audit-resolutions.md",
          "min_bytes": 1024
        }
      ],
      "required_state_fields": [
        {
          "kind": "json_path_present",
          "path": "state.json",
          "json_path": ".audit_findings_total"
        },
        {
          "kind": "json_path_present",
          "path": "state.json",
          "json_path": ".audit_findings_resolved_count"
        },
        {
          "kind": "audit_resolution_complete",
          "path": "state.json"
        }
      ],
      "required_sub_step_gates": ["audit-resolution-fired", "audit-findings-exit-predicate"],
      "comment": "W2 (harness-audit-resolution-and-scope-v1, AC-5): explicit 4-day fix capacity between verifying + pre-deploy. Exit predicate (audit_resolution_complete kind, new in phase-predicates.sh) asserts resolved_count + deferred[].length + accepted[].length == audit_findings_total AND every deferred entry has non-empty deferred_to_sprint + ac_id."
    },
    "review-resolution": {
      "advances_to": ["pre-deploy", "verifying", "paused"],
      "required_artifacts": [
        {
          "kind": "file_min_bytes",
          "path": "review-resolutions.md",
          "min_bytes": 1024
        }
      ],
      "required_state_fields": [
        {
          "kind": "review_resolution_complete",
          "path": "state.json"
        }
      ],
      "required_sub_step_gates": ["review-resolution-fired", "review-findings-exit-predicate"],
      "comment": "W1 (harness-review-resolution-v1, AC-1): superset of audit-resolution. Aggregates audit + knip + sonar findings under unified review_findings[]. audit-resolution stays as legacy alias."
    }
  }
}
