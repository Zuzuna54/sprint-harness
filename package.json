{
  "name": "@ordex/sprint-harness",
  "version": "0.4.0",
  "description": "Shape Up + SPARC sprint harness with drift control, inject-violation-catch-restore methodology, multi-sprint parallel support, and full Claude Code + ruflo integration.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sprint-harness": "./bin/sprint-harness.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "docs/",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/Zuzuna54/sprint-harness#readme",
  "keywords": [
    "sprint",
    "shape-up",
    "sparc",
    "drift-control",
    "claude-code",
    "ruflo",
    "harness",
    "agentic-workflow",
    "inject-catch-restore"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node bin/sprint-harness.mjs verify",
    "doctor": "node bin/sprint-harness.mjs doctor",
    "test": "npm run test:install && npm run test:matrix && npm run test:71-acs",
    "test:install": "node tests/install-smoke.mjs",
    "test:matrix": "node tests/install-matrix.mjs",
    "test:71-acs": "node tests/run-all-71-acs.mjs",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zuzuna54/sprint-harness.git"
  },
  "bugs": {
    "url": "https://github.com/Zuzuna54/sprint-harness/issues"
  },
  "author": "Giorgi Giorgobiani <giorgigiorgobiani54@gmail.com>",
  "publishConfig": {
    "access": "public"
  }
}