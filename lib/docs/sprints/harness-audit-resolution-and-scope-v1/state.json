    {
      "har_id": "HAR-3",
      "severity": "low",
      "file": ".claude/helpers/memory.js",
      "line": 57,
      "description": "Key file permissions verified on read, but no integrity/MAC verification of the key file itself. If permissions are compromised by an attacker with system access, the key could be read or tampered with before validation occurs.",
      "deferred_to_sprint": "harness-key-rotation-v1",
      "ac_id": "AC-2",
      "rationale": "Key file integrity/MAC is part of full key rotation policy; both must ship together. Filed for harness-key-rotation-v1 follow-up sprint. Current 0600 perms + crypto.randomBytes(32) provide baseline confidentiality.",
      "deferred_at": "2026-05-19T18:50:29Z"
    }
  ],
  "audit_findings_accepted": [
    {
      "har_id": "HAR-1",
      "severity": "low",
      "file": ".claude/helpers/session.js",
      "line": 32,
      "description": "Code injection pattern detection using simple regex. The pattern `/\\beval\\b|\\bnew\\s+Function\\b|\\$\\{|`/` may not catch all code injection variants (e.g., 'eval ' with extra spaces, or using Function constructor indirectly). This is adequate as defense-in-depth but not foolproof.",
      "risk_owner": "gio",
      "business_rationale": "Defense-in-depth simple regex is intentional. Real validation is at zod boundaries; this is belt-and-suspenders. Replacing with a parser would be overkill for the threat model (operator typing into context). Documented in session.js validateContextValue comment.",
      "accepted_at": "2026-05-19T18:50:28Z"
    },
    {
      "har_id": "HAR-2",
      "severity": "low",
      "file": ".claude/helpers/session.js",
      "line": 21,
      "description": "Arbitrary recursion depth limit of 4 levels in validateContextValue(). Values nested beyond 4 levels are rejected, which could cause unexpected validation failures for deeply nested legitimate data structures.",
      "risk_owner": "gio",
      "business_rationale": "Depth=4 bound is documented intentional limit. Sessions store flat key-value context not arbitrary trees. Higher bound enables stack-overflow DoS via malicious nested objects. 4 is sufficient for plain config + sub-objects.",
      "accepted_at": "2026-05-19T18:50:28Z"
    },
    {
      "har_id": "HAR-4",
      "severity": "low",
      "file": ".claude/helpers/github-safe.js",
      "line": 48,
      "description": "Shell metacharacter check skips flag values entirely (as noted: 'skip shell-meta check for flag VALUES'). While this is safe due to file piping, a flag injection attack through crafted titles/bodies could theoretically occur if the piping mechanism fails.",
      "risk_owner": "gio",
      "business_rationale": "Flag values (body content) intentionally bypass shell-meta check because bodies go through tmpfile + body-file flag to gh, never inlined into shell command. Documented in github-safe.js validateArgs comment.",
      "accepted_at": "2026-05-19T18:50:29Z"
    }
  ],
