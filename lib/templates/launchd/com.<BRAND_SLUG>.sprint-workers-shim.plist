<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.<BRAND_SLUG>.sprint-workers-shim</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/gio/Desktop/<BRAND_SLUG>/scripts/sprint-workers-shim.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>REPO_ROOT</key>
    <string>/Users/gio/Desktop/<BRAND_SLUG></string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardErrorPath</key>
  <string>/Users/gio/Desktop/<BRAND_SLUG>/.swarm/workers-shim.err</string>

  <key>StandardOutPath</key>
  <string>/Users/gio/Desktop/<BRAND_SLUG>/.swarm/workers-shim.log</string>
</dict>
</plist>
